# Optional. Phase 1 runs in Demo Mode even when a database is configured.
# Pooled connection for the app. Use a Neon development branch locally.
# Never prefix database URLs or auth secrets with NEXT_PUBLIC_.
DATABASE_URL=

# Direct connection to the same development branch, used by Drizzle Kit.
# When unset, Drizzle Kit falls back to DATABASE_URL for existing setups.
DATABASE_URL_UNPOOLED=

# Optional. Enables the Generate AI Analysis button on the commander dashboard.
# Create a key in Google AI Studio. Server-side only: never prefix it with NEXT_PUBLIC_.
# Without it the dashboard works and the AI panel reports that AI is not configured.
GEMINI_API_KEY=
# Optional model override. Defaults to the stable gemini-3.8-flash.
# GEMINI_MODEL=

# Optional preparation for Phase 2. These do not enable authentication yet.
# The setup wizard can generate a secret locally without showing it.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
